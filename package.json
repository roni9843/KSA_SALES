{
  "name": "moto_pos",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"cross-env BROWSER=none npm run dev-react\" \"npm run dev-electron\"",
    "dev-react": "cd renderer && npm run dev",
    "dev-electron": "electron .",
    "build": "cd renderer && npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.moto.pos",
    "productName": "Moto POS",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "files": [
      "dist",
      "src",
      "renderer/dist",
      "node_modules",
      "package.json"
    ]
  },
  "dependencies": {
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.6.0"
  }
}